# Only use an HTTPS origin behind a correctly configured TLS reverse proxy.
TEAMS_SITE_ORIGIN=https://teams.yourdomain.example
PORT=3030
HOST=0.0.0.0
TEAMS_DB_PATH=/data/teams.sqlite

# Before first owner registration, set a high-entropy value (32–256 chars).
# Generate it locally with: openssl rand -hex 32
# Keep actual values in an untracked operator .env file, not Git.
TEAMS_BOOTSTRAP_TOKEN=
