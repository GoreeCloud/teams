{
  "name": "goreecloud-teams",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted team collaboration with native Linux and Android clients",
  "workspaces": ["apps/server", "apps/web"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:server": "npm run dev -w @goreecloud/teams-server",
    "dev:web": "npm run dev -w @goreecloud/teams-web",
    "build": "npm run build -w @goreecloud/teams-web",
    "test": "npm run test -w @goreecloud/teams-server",
    "backup": "node scripts/backup.mjs",
    "backup:bundle": "node scripts/backup-bundle.mjs",
    "verify:action-pins": "node --test scripts/verify-action-pins.test.mjs && node scripts/verify-action-pins.mjs",
    "test:realtime": "node --test apps/web/test/*.test.mjs",
    "check": "npm run verify:action-pins && npm run check -w @goreecloud/teams-web && npm run test:realtime && npm test && npm run build"
  },
  "license": "MIT"
}
